---
import { Image } from 'astro:assets';
import logoDarlin from '../assets/logos/logo-darlin.png';
import logoEdie from '../assets/logos/logo-edie.png';
import logoFeelLikeMakinLove from '../assets/logos/logo-feellikemakinlove.png';
---

<nav id="site-nav" class="fixed top-0 left-0 w-full backdrop-blur-sm bg-white/70 grid grid-cols-3 items-center px-6 md:px-12 py-6 md:py-4 border-b border-stone-100 z-50">

	<div class="justify-self-start flex items-center">
	  <button id="menu-open" aria-expanded="false" class="flex flex-col gap-1.5 p-1" aria-label="Menu">
		<span class="w-4 h-[1px] bg-stone-950"></span>
		<span class="w-4 h-[1px] bg-stone-950"></span>
	  </button>
	</div>

	<div class="justify-self-center hidden md:flex items-center gap-8">
	  <a href="/access#darlin" class="hover:opacity-70 transition-opacity">
		<Image src={logoDarlin} alt="darlin. logo" loading="eager" class="h-4.5 w-auto object-contain" />
	  </a>
	  <a href="/access#edie" class="hover:opacity-70 transition-opacity">
		<Image src={logoEdie} alt="EDIE logo" loading="eager" class="h-5.5 w-auto object-contain" />
	  </a>
	  <a href="/access#feel-like-makin-love" class="hover:opacity-70 transition-opacity">
		<Image src={logoFeelLikeMakinLove} alt="Feel Like Makin' Love logo" loading="eager" class="h-7 w-auto object-contain" />
	  </a>
	</div>

	<div class="justify-self-end flex items-center">
	  <a
		href="/reserve"
		target="_blank"
		rel="noopener noreferrer"
		class="hidden md:flex border border-stone-950 text-stone-950 text-[10px] font-bold tracking-[0.2em] px-5 py-2 rounded-full hover:bg-stone-950 hover:text-white transition-all duration-300"
	  >
		RESERVE
	  </a>
	</div>

	<div class="md:hidden flex items-center gap-6 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
	  <a href="/access#darlin" class="hover:opacity-70 transition-opacity">
		<Image src={logoDarlin} alt="darlin. logo" loading="eager" class="h-4 w-auto object-contain" />
	  </a>
	  <a href="/access#edie" class="hover:opacity-70 transition-opacity">
		<Image src={logoEdie} alt="EDIE logo" loading="eager" class="h-4.5 w-auto object-contain" />
	  </a>
	  <a href="/access#feel-like-makin-love" class="hover:opacity-70 transition-opacity">
		<Image src={logoFeelLikeMakinLove} alt="Feel Like Makin' Love logo" loading="eager" class="h-5.5 w-auto object-contain" />
	  </a>
	</div>

</nav>

<div id="menu-dropdown" class="fixed left-1 w-full backdrop-blur-sm bg-white/70 border-b border-stone-100 overflow-hidden z-40 transition-[max-height] duration-300 ease-in-out" style="max-height: 0px;">
  <div id="menu-dropdown-inner" class="flex flex-col items-start md:gap-0 px-4 md:px-8 py-4 md:py-4">
    <div class="flex flex-col gap-2 md:gap-1 text-[13px] md:text-[14px] tracking-[0.1em] font-base text-stone-600 px-3">
      <a href="/" class="hover:text-stone-950 transition-colors">home</a>
      <a href="/menu" class="hover:text-stone-500 transition-colors">menu</a>
      <a href="/staff" class="hover:text-stone-500 transition-colors">staff</a>
      <a href="/blog/" class="hover:text-stone-500 transition-colors">blog</a>
      <a href="/event" class="hover:text-stone-500 transition-colors">event</a>
      <a href="/access" class="hover:text-stone-500 transition-colors">access</a>
      <a href="/about" class="hover:text-stone-500 transition-colors">about</a>
      <a
        href="https://www.instagram.com/darlin_edie_flml/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-stone-500 transition-colors"
      >
        instagram
      </a>

      <a
        href="/reserve"
        target="_blank"
        rel="noopener noreferrer"
        class="md:hidden self-start -ml-3 border border-stone-950 text-stone-950 text-[11px] font-bold tracking-[0.2em] px-5 py-2 rounded-full bg-transparent shadow-sm mt-1 hover:bg-stone-950 hover:text-white transition-colors duration-300"
      >
        RESERVE
      </a>
    </div>
  </div>
</div>

<div id="menu-spacer" class="transition-[height] duration-300 ease-in-out" style="height: 0px;"></div>

<script>
  const nav = document.getElementById('site-nav') as HTMLElement | null;
  const openBtn = document.getElementById('menu-open') as HTMLButtonElement | null;
  const dropdown = document.getElementById('menu-dropdown') as HTMLElement | null;
  const dropdownInner = document.getElementById('menu-dropdown-inner') as HTMLElement | null;
  const spacer = document.getElementById('menu-spacer') as HTMLElement | null;

  function syncNavOffset() {
    if (!nav || !dropdown) return;
    dropdown.style.top = `${nav.offsetHeight}px`;
  }

  function isOpen() {
    return openBtn?.getAttribute('aria-expanded') === 'true';
  }

  function openMenu() {
    if (!dropdown || !dropdownInner || !spacer || !openBtn) return;
    syncNavOffset();
    const contentHeight = dropdownInner.scrollHeight;
    dropdown.style.maxHeight = `${contentHeight}px`;
    spacer.style.height = `${contentHeight}px`;
    openBtn.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    if (!dropdown || !spacer || !openBtn) return;
    dropdown.style.maxHeight = '0px';
    spacer.style.height = '0px';
    openBtn.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', () => {
    isOpen() ? closeMenu() : openMenu();
  });

  document.addEventListener('click', (event) => {
    if (!isOpen()) return;
    const target = event.target as Node;
    if (nav?.contains(target) || dropdown?.contains(target)) return;
    closeMenu();
  });

  window.addEventListener('resize', () => {
    syncNavOffset();
    if (isOpen()) openMenu();
  });

  syncNavOffset();
</script>
