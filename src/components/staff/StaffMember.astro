---
import type { StaffMemberData } from '../../lib/staff';
import { optimizeImageUrl } from '../../lib/microcms';

interface Props {
  member: StaffMemberData;
}

const { member } = Astro.props;

// Match all three photos to the height of the most square one; the others are object-fit: cover-cropped to fit.
const sharedRatio = Math.max(...member.data.photos.map((photo) => photo.width / photo.height));
---

<div>
  <h3 class="text-base md:text-lg font-medium tracking-wide text-stone-950">
    {member.data.name}
  </h3>

  <p class="mt-1 text-xs tracking-[0.1em] text-stone-400">
    {member.data.position}
  </p>

  <a
    href={member.data.instagram}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-2 inline-flex items-center gap-1.5 text-xs tracking-[0.1em] text-stone-500 hover:text-stone-950 transition-colors"
  >
    <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </svg>
    Instagram
  </a>

  <button
    type="button"
    aria-expanded="false"
    class="staff-photos-toggle group/photos mt-1 flex items-center gap-1.5 text-xs tracking-[0.15em] text-stone-400 hover:text-stone-950 transition-colors cursor-pointer"
  >
    <span class="inline-block transition-transform duration-200 group-aria-expanded/photos:rotate-90">›</span>
    Photos
  </button>

  <div class="staff-photos-panel overflow-hidden opacity-0 transition-[max-height,opacity] duration-300 ease-in-out" style="max-height: 0px;">
    <div class="grid grid-cols-3 gap-0.5 mt-3">
      {member.data.photos.map((photo) => (
        <div
          class="w-full border border-stone-100 overflow-hidden"
          style={`aspect-ratio: ${sharedRatio}`}
        >
          <img
            src={optimizeImageUrl(photo.url, 400)}
            alt={member.data.name}
            loading="lazy"
            class="w-full h-full object-cover block"
          />
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.staff-photos-toggle').forEach((button) => {
    const panel = button.nextElementSibling as HTMLElement | null;
    if (!panel) return;

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        panel.style.maxHeight = '0px';
        panel.classList.remove('opacity-100');
        panel.classList.add('opacity-0');
        button.setAttribute('aria-expanded', 'false');
      } else {
        panel.style.maxHeight = `${panel.scrollHeight}px`;
        panel.classList.remove('opacity-0');
        panel.classList.add('opacity-100');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
