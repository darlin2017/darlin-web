---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { buildHairSalonSchema } from '../../lib/structuredData';
import darlinLogo from '../../assets/access/darlin02_access.png';
import edieLogo from '../../assets/access/edie02_access.png';
import flmlLogo from '../../assets/access/flml02_access.png';

interface Props {
  store: CollectionEntry<'access'>;
  eager?: boolean;
}

const STORE_LOGOS: Record<string, { src: ImageMetadata; heightClass: string }> = {
  darlin: { src: darlinLogo, heightClass: 'h-16 md:h-20' },
  edie: { src: edieLogo, heightClass: 'h-16 md:h-18' },
  'feel-like-makin-love': { src: flmlLogo, heightClass: 'h-20 md:h-22' },
};

const { store, eager = false } = Astro.props;
const telHref = `tel:${store.data.phone.replace(/-/g, '')}`;
const hoursLines = store.data.hours.split('\n');

// Match both photos to the height of the more square one; the other is object-fit: cover-cropped to fit.
const sharedRatio = Math.max(...store.data.photos.map((photo) => photo.width / photo.height));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(store.data.photos[0].src, Astro.site).href;
const hairSalonSchema = buildHairSalonSchema(
  {
    storeName: store.data.storeName,
    address: store.data.address,
    postalCode: store.data.postalCode,
    phone: store.data.phone,
    hours: store.data.hours,
    mapUrl: store.data.mapUrl,
  },
  pageUrl,
  imageUrl,
  store.id
);
---

<section id={store.id} class="scroll-mt-26 md:scroll-mt-28">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(hairSalonSchema)} />
  <h2>
    <Image
      src={STORE_LOGOS[store.id].src}
      alt={store.data.storeName}
      loading={eager ? 'eager' : 'lazy'}
      class={`${STORE_LOGOS[store.id].heightClass} w-auto object-contain`}
    />
  </h2>

  <div class="mt-4 grid grid-cols-2 gap-0.5">
    {store.data.photos.map((photo) => (
      <div
        class="w-full border border-stone-100 overflow-hidden"
        style={`aspect-ratio: ${sharedRatio}`}
      >
        <img
          src={photo.src}
          alt={store.data.storeName}
          loading={eager ? 'eager' : 'lazy'}
          class="w-full h-full object-cover block"
        />
      </div>
    ))}
  </div>

  <p class="mt-6 text-sm text-stone-700 tracking-[0.03em]">〒{store.data.postalCode}</p>
  <p class="mt-1 text-sm text-stone-700 leading-relaxed tracking-[0.03em]">{store.data.address}</p>

  <a
    href={store.data.mapUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-2 inline-block text-xs tracking-[0.15em] text-stone-400 hover:text-stone-950 transition-colors uppercase"
  >
    Map →
  </a>

  <div class="mt-6 flex flex-col gap-1 text-sm text-stone-600 tracking-[0.03em]">
    {hoursLines.length > 1 ? (
      <>
        <p>Opening Hours :</p>
        {hoursLines.map((line) => <p class="pl-4">{line}</p>)}
      </>
    ) : (
      <p>Opening Hours : {hoursLines[0]}</p>
    )}
    <p>Closed : {store.data.closedDays}</p>
    <p>
      Tel : <a href={telHref} class="hover:text-stone-950 transition-colors tracking-[0.03em]">
        {store.data.phone}
      </a>
    </p>
  </div>

  <a
    href={store.data.reserveUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex border border-stone-950 text-stone-950 text-[10px] font-bold tracking-[0.2em] px-6 py-2.5 rounded-full hover:bg-stone-950 hover:text-white transition-all duration-300"
  >
    RESERVE
  </a>
</section>
