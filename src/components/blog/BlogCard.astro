---
import { formatDate, type BlogPost } from '../../lib/blog';
import { optimizeImageUrl } from '../../lib/microcms';

interface Props {
  post: BlogPost;
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
---

<article>
  <a href={`/blog/${post.id}/`} class="group block">
    <div class="max-w-[500px] mx-auto">
      {post.data.eyecatch && (
        <div
          class="border border-stone-100 overflow-hidden"
          style={`aspect-ratio: ${post.data.eyecatch.width / post.data.eyecatch.height}`}
        >
          <img
            src={optimizeImageUrl(post.data.eyecatch.url, 800)}
            alt={post.data.title}
            loading={eager ? 'eager' : 'lazy'}
            class="w-full h-full object-cover block"
          />
        </div>
      )}

      <h2 class="mt-2 text-base md:text-base font-medium tracking-wide text-stone-950 group-hover:opacity-60 transition-opacity">
        {post.data.title}
      </h2>

      <p class="mt-1 text-xs text-stone-400">
        {post.data.author}
      </p>

      <p class="mt-1 text-xs tracking-[0.00em] text-stone-400 uppercase">
        {formatDate(post.data.publishDate)}
      </p>
    </div>
  </a>
</article>
