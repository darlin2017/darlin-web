---
import type { ArchiveGroup } from '../../lib/blog';

interface Props {
  groups: ArchiveGroup[];
}

const { groups } = Astro.props;
---

{groups.length > 0 && (
  <details class="group py-5">
    <summary class="group flex items-center justify-center gap-1 text-[9px] tracking-[0.3em] text-stone-400 hover:text-stone-950 transition-colors cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
      <span class="inline-block transition-transform duration-200 group-open:rotate-90">›</span>
      Archive
    </summary>
    <div class="flex flex-col items-center gap-2 mt-4">
      {groups.map((archiveGroup) => (
        <div class="w-full max-w-md">
          <button
            type="button"
            aria-expanded="false"
            class="archive-year-toggle group/year flex items-center justify-center gap-1 w-full text-xs tracking-[0.15em] text-stone-500 hover:text-stone-950 transition-colors cursor-pointer"
          >
            <span class="inline-block transition-transform duration-200 group-aria-expanded/year:rotate-90">›</span>
            {archiveGroup.year}
          </button>

          <div class="archive-year-panel overflow-hidden transition-[max-height] duration-300 ease-in-out" style="max-height: 0px;">
            <ul class="flex flex-col gap-3 max-w-md mx-auto pt-4 pb-1">
              {archiveGroup.posts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.id}/`}
                    class="group/post flex items-baseline justify-between gap-4"
                  >
                    <span class="text-xs text-stone-600 group-hover/post:text-stone-950 transition-colors">
                      {post.title}
                    </span>
                    <span class="text-[10px] text-stone-400 shrink-0">{post.author}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </details>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.archive-year-toggle').forEach((button) => {
    const panel = button.nextElementSibling as HTMLElement | null;
    if (!panel) return;

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        panel.style.maxHeight = '0px';
        button.setAttribute('aria-expanded', 'false');
      } else {
        panel.style.maxHeight = `${panel.scrollHeight}px`;
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
