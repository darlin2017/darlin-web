---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section class="scroll-gallery relative bg-white h-dvh flex flex-col overflow-hidden">
  <div class="scroll-gallery-pin flex-1 flex items-center overflow-hidden">
    <div class="scroll-gallery-track flex gap-2 pt-16">
      {images.map((image, index) => (
        <div class="scroll-gallery-slide w-[350px] md:w-[460px] aspect-[3/4] shrink-0 border border-stone-100 overflow-hidden">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover block"
            loading={index < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <div class="shrink-0">
    <slot name="footer" />
  </div>
</section>

<script>
  // Device split is by input capability, not viewport width — a touch tablet
  // (e.g. iPad mini) can share a width with a desktop breakpoint, so width
  // alone can't tell them apart. Only devices whose PRIMARY input is a mouse
  // or trackpad (hover + fine pointer) get the GSAP ScrollTrigger pin/scrub
  // setup; everything else uses the plain native scrolling container defined
  // in the <style> block (phone vs tablet sub-split is CSS-only too, by
  // width, since neither needs any JS).
  //
  // GSAP + ScrollTrigger (~114KB) are only ever relevant to that desktop
  // path, so they're dynamically imported — Vite splits them into a separate
  // chunk that's simply never requested on phones/tablets, instead of being
  // bundled into a script every visitor downloads regardless of device.
  const DESKTOP_QUERY = '(hover: hover) and (pointer: fine)';

  let desktopGallerySetup = false;

  async function setupDesktopGallery() {
    if (desktopGallerySetup) return;
    desktopGallerySetup = true;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    const mm = gsap.matchMedia();

    mm.add(DESKTOP_QUERY, () => {
      // Prevents iOS/mobile-browser address-bar show/hide from firing a
      // resize event that triggers ScrollTrigger's default refresh() —
      // refreshing mid-scroll while a section is pinned causes a one-frame
      // jump. Mostly relevant to hybrid laptops (touchscreen + trackpad)
      // that land here.
      ScrollTrigger.config({ ignoreMobileResize: true });

      // Smooths out scroll jank around pinned sections for any touch input a
      // mouse-primary device might still also receive.
      ScrollTrigger.normalizeScroll({ momentum: 1 });

      document.querySelectorAll<HTMLElement>('.scroll-gallery').forEach((section) => {
        const track = section.querySelector<HTMLElement>('.scroll-gallery-track');
        if (!track) return;

        // Lower SPEED = more vertical scroll needed to cover the same horizontal distance (feels slower).
        const SPEED = 0.65;
        const getScrollLength = () => track.scrollWidth - window.innerWidth;
        if (getScrollLength() <= 0) return;

        gsap.to(track, {
          x: () => -getScrollLength(),
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top top',
            end: () => `+=${getScrollLength() / SPEED}`,
            scrub: 1,
            pin: true,
            invalidateOnRefresh: true,
          },
        });
      });
    });
  }

  const desktopMql = window.matchMedia(DESKTOP_QUERY);

  if (desktopMql.matches) {
    setupDesktopGallery();
  } else {
    // Covers a device switching primary input mid-session (e.g. a mouse
    // plugged into a tablet) without ever loading GSAP for devices that
    // stay touch-only the whole time.
    desktopMql.addEventListener(
      'change',
      (event) => {
        if (event.matches) setupDesktopGallery();
      },
      { once: true }
    );
  }
</script>

<style>
  .scroll-gallery-track {
    will-change: transform;
    scrollbar-width: none;
  }
  .scroll-gallery-track::-webkit-scrollbar {
    display: none;
  }

  /* Default: touch, phone-width — snap one image at a time, centered. */
  .scroll-gallery-track {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: calc(50% - 185px);
  }
  .scroll-gallery-slide {
    scroll-snap-align: center;
  }

  /* Touch, tablet-width — free-scrolling, no snap. */
  @media (min-width: 641px) {
    .scroll-gallery-track {
      scroll-snap-type: none;
      padding-inline: 1rem;
    }
  }

  /* Mouse/trackpad-primary devices — hand off entirely to GSAP above. */
  @media (hover: hover) and (pointer: fine) {
    .scroll-gallery-track {
      overflow-x: visible;
      scroll-snap-type: none;
      padding-inline: 1rem;
      width: auto;
    }
    .scroll-gallery-slide {
      scroll-snap-align: none;
    }
  }
</style>
