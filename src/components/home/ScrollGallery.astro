---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section class="scroll-gallery relative bg-white h-dvh flex flex-col overflow-hidden">
  <div class="scroll-gallery-pin flex-1 flex items-center overflow-hidden">
    <div class="scroll-gallery-track flex gap-2 md:gap-2 px-4 md:px-4 pt-16">
      {images.map((image, index) => (
        <div class="w-[350px] md:w-[460px] aspect-[3/4] shrink-0 border border-stone-100 overflow-hidden">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover block"
            loading={index < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <div class="shrink-0">
    <slot name="footer" />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Smooths out mobile Safari/Chrome scroll jank around pinned sections
  // (address bar resize, momentum scroll conflicts with the pin).
  ScrollTrigger.normalizeScroll(true);

  document.querySelectorAll<HTMLElement>('.scroll-gallery').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.scroll-gallery-track');
    if (!track) return;

    // Lower SPEED = more vertical scroll needed to cover the same horizontal distance (feels slower).
    const SPEED = 0.8;
    const getScrollLength = () => track.scrollWidth - window.innerWidth;
    if (getScrollLength() <= 0) return;

    const scrollTween = gsap.to(track, {
      x: () => -getScrollLength(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => `+=${getScrollLength() / SPEED}`,
        scrub: 1,
        pin: true,
        invalidateOnRefresh: true,
      },
    });
    const scrollTriggerInstance = scrollTween.scrollTrigger;

    // Mobile only: let a horizontal swipe drive the same vertical scroll position
    // ScrollTrigger already reads, instead of maintaining a second "progress" value
    // that could drift out of sync with it. The gesture is axis-locked on the first
    // few pixels of movement so an ordinary vertical swipe still scrolls the page.
    const isMobile = () => window.innerWidth < 768;

    // Higher = more horizontal movement per pixel of finger travel.
    const SWIPE_MULTIPLIER = 3;

    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartScrollY = 0;
    let dragAxis: 'none' | 'horizontal' | 'vertical' = 'none';

    section.addEventListener(
      'touchstart',
      (event) => {
        if (!isMobile()) return;
        const touch = event.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        touchStartScrollY = window.scrollY;
        dragAxis = 'none';
      },
      { passive: true }
    );

    section.addEventListener(
      'touchmove',
      (event) => {
        if (!isMobile()) return;
        const touch = event.touches[0];
        const deltaX = touchStartX - touch.clientX;
        const deltaY = touchStartY - touch.clientY;

        if (dragAxis === 'none') {
          if (Math.abs(deltaX) < 10 && Math.abs(deltaY) < 10) return;
          dragAxis = Math.abs(deltaX) > Math.abs(deltaY) ? 'horizontal' : 'vertical';
        }

        if (dragAxis === 'horizontal') {
          event.preventDefault();
          window.scrollTo(0, touchStartScrollY + (deltaX * SWIPE_MULTIPLIER) / SPEED);
        }
        // dragAxis === 'vertical': do nothing and let the page scroll natively;
        // ScrollTrigger is already watching that same scroll position.
      },
      { passive: false }
    );

    // Snaps to the nearest slide's edge after a horizontal drag ends, instead of
    // leaving the gallery stopped mid-image. Rounding to the nearest slide index
    // naturally means a drag past the halfway point advances to the next/prev
    // slide, short of that snaps back — matching a standard carousel feel.
    function snapToNearestImage() {
      if (!scrollTriggerInstance) return;
      const slides = Array.from(track!.children) as HTMLElement[];
      if (slides.length < 2) return;

      const pitch = slides[1].offsetLeft - slides[0].offsetLeft;
      const scrollLength = getScrollLength();
      const currentX = scrollLength * scrollTriggerInstance.progress;
      const nearestIndex = Math.round(currentX / pitch);
      const clampedIndex = Math.max(0, Math.min(slides.length - 1, nearestIndex));
      const targetX = Math.min(clampedIndex * pitch, scrollLength);
      const targetScrollY = scrollTriggerInstance.start + targetX / SPEED;

      window.scrollTo({ top: targetScrollY, behavior: 'smooth' });
    }

    section.addEventListener(
      'touchend',
      () => {
        if (isMobile() && dragAxis === 'horizontal') {
          snapToNearestImage();
        }
        dragAxis = 'none';
      },
      { passive: true }
    );
  });
</script>

<style>
  .scroll-gallery-track {
    will-change: transform;
  }
</style>
