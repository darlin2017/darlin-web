---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section class="scroll-gallery relative bg-white h-dvh flex flex-col overflow-hidden">
  <div class="scroll-gallery-pin flex-1 flex items-center overflow-hidden">
    <div class="scroll-gallery-track flex gap-2 md:gap-2 px-4 md:px-4 pt-16">
      {images.map((image, index) => (
        <div class="w-[350px] md:w-[460px] aspect-[3/4] shrink-0 border border-stone-100 overflow-hidden">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover block"
            loading={index < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <div class="shrink-0">
    <slot name="footer" />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Smooths out mobile Safari/Chrome scroll jank around pinned sections
  // (address bar resize, momentum scroll conflicts with the pin). Returns a
  // normalizer that owns the (virtualized) scroll position on touch devices —
  // programmatic scroll changes must go through normalizer.scrollY(), since a
  // raw window.scrollTo() doesn't reliably reach ScrollTrigger's tracked
  // progress once normalization has taken over.
  const normalizer = ScrollTrigger.normalizeScroll(true);

  document.querySelectorAll<HTMLElement>('.scroll-gallery').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.scroll-gallery-track');
    if (!track) return;

    // Lower SPEED = more vertical scroll needed to cover the same horizontal distance (feels slower).
    const SPEED = 0.8;
    const getScrollLength = () => track.scrollWidth - window.innerWidth;
    if (getScrollLength() <= 0) return;

    const scrollTween = gsap.to(track, {
      x: () => -getScrollLength(),
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: () => `+=${getScrollLength() / SPEED}`,
        scrub: 1,
        pin: true,
        invalidateOnRefresh: true,
      },
    });
    const scrollTriggerInstance = scrollTween.scrollTrigger!;

    const setScrollY = (y: number) => {
      if (normalizer) {
        normalizer.scrollY(y);
      } else {
        window.scrollTo(0, y);
      }
    };

    // Mobile only: let a horizontal swipe drive the same vertical scroll position
    // ScrollTrigger already reads, instead of maintaining a second "progress" value
    // that could drift out of sync with it. The gesture is axis-locked on the first
    // few pixels of movement so an ordinary vertical swipe still scrolls the page.
    const isMobile = () => window.innerWidth < 768;

    // Higher = more horizontal movement per pixel of finger travel.
    const SWIPE_MULTIPLIER = 3;

    // How far (as a fraction of one slide's width) a swipe must travel from the
    // slide shown at touchstart before it counts as a deliberate move to the
    // next/prev slide, rather than snapping back to where it started.
    const DRAG_THRESHOLD_RATIO = 0.2;

    const getSlidePitch = () => {
      const slides = Array.from(track!.children) as HTMLElement[];
      return slides.length >= 2 ? slides[1].offsetLeft - slides[0].offsetLeft : null;
    };

    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartScrollY = 0;
    let dragAxis: 'none' | 'horizontal' | 'vertical' = 'none';
    let dragStartIndex = 0;

    section.addEventListener(
      'touchstart',
      (event) => {
        if (!isMobile()) return;
        const touch = event.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        touchStartScrollY = window.scrollY;
        dragAxis = 'none';

        const pitch = getSlidePitch();
        if (pitch) {
          const currentX = getScrollLength() * scrollTriggerInstance.progress;
          dragStartIndex = Math.round(currentX / pitch);
        }
      },
      { passive: true }
    );

    section.addEventListener(
      'touchmove',
      (event) => {
        if (!isMobile()) return;
        const touch = event.touches[0];
        const deltaX = touchStartX - touch.clientX;
        const deltaY = touchStartY - touch.clientY;

        if (dragAxis === 'none') {
          if (Math.abs(deltaX) < 10 && Math.abs(deltaY) < 10) return;
          dragAxis = Math.abs(deltaX) > Math.abs(deltaY) ? 'horizontal' : 'vertical';
        }

        if (dragAxis === 'horizontal') {
          event.preventDefault();
          setScrollY(touchStartScrollY + (deltaX * SWIPE_MULTIPLIER) / SPEED);
        }
        // dragAxis === 'vertical': do nothing and let the page scroll natively;
        // ScrollTrigger is already watching that same scroll position.
      },
      { passive: false }
    );

    // Snaps to the next/prev slide's edge after a horizontal drag ends, instead
    // of leaving the gallery stopped mid-image. Direction is judged relative to
    // the slide shown when the drag started: moving past DRAG_THRESHOLD_RATIO of
    // one slide's width in either direction advances that way, anything short of
    // that snaps back — so a light, short swipe is enough to change slides.
    function snapToNearestImage() {
      const slides = Array.from(track!.children) as HTMLElement[];
      if (slides.length < 2) return;

      const pitch = slides[1].offsetLeft - slides[0].offsetLeft;
      const scrollLength = getScrollLength();
      const currentX = scrollLength * scrollTriggerInstance.progress;
      const startX = dragStartIndex * pitch;
      const deltaRatio = (currentX - startX) / pitch;

      let targetIndex = dragStartIndex;
      if (deltaRatio > DRAG_THRESHOLD_RATIO) {
        targetIndex = dragStartIndex + 1;
      } else if (deltaRatio < -DRAG_THRESHOLD_RATIO) {
        targetIndex = dragStartIndex - 1;
      }

      const clampedIndex = Math.max(0, Math.min(slides.length - 1, targetIndex));
      const targetX = Math.min(clampedIndex * pitch, scrollLength);
      const targetScrollY = scrollTriggerInstance.start + targetX / SPEED;

      const proxy = { y: window.scrollY };
      gsap.to(proxy, {
        y: targetScrollY,
        duration: 0.4,
        ease: 'power2.out',
        overwrite: true,
        onUpdate: () => setScrollY(proxy.y),
      });
    }

    section.addEventListener(
      'touchend',
      () => {
        if (isMobile() && dragAxis === 'horizontal') {
          snapToNearestImage();
        }
        dragAxis = 'none';
      },
      { passive: true }
    );
  });
</script>

<style>
  .scroll-gallery-track {
    will-change: transform;
  }
</style>
