---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section class="scroll-gallery-v2 relative bg-white md:h-dvh flex flex-col overflow-hidden">
  <div class="scroll-gallery-v2-pin md:flex-1 flex md:items-center overflow-hidden">
    <div class="scroll-gallery-v2-track flex flex-col md:flex-row gap-1.5 md:gap-2 px-4 md:px-4 pt-24 py-9 w-full md:w-auto">
      {images.map((image, index) => (
        <div class="w-full md:w-[460px] aspect-[3/4] shrink-0 border border-stone-100 overflow-hidden">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover block"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>

  <div class="shrink-0">
    <slot name="footer" />
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Smooths out mobile Safari/Chrome scroll jank around pinned sections
  // (address bar resize, momentum scroll conflicts with the pin).
  ScrollTrigger.normalizeScroll(true);

  document.querySelectorAll<HTMLElement>('.scroll-gallery-v2').forEach((section) => {
    const track = section.querySelector<HTMLElement>('.scroll-gallery-v2-track');
    if (!track) return;

    const mm = gsap.matchMedia();

    // Desktop only: below md, this never registers, so the gallery is a plain vertical scroll.
    mm.add('(min-width: 768px)', () => {
      const SPEED = 0.8;
      const getScrollLength = () => track.scrollWidth - window.innerWidth;
      if (getScrollLength() <= 0) return;

      const tween = gsap.to(track, {
        x: () => -getScrollLength(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${getScrollLength() / SPEED}`,
          scrub: 1,
          pin: true,
          invalidateOnRefresh: true,
        },
      });

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
      };
    });
  });
</script>

<style>
  .scroll-gallery-v2-track {
    will-change: transform;
  }
</style>
