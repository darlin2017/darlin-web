---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StoreSection from '../components/access/StoreSection.astro';

const stores = await getCollection('access');
---

<Layout
  title="Access | darlin. / EDIE / Feel Like Makin' Love"
  description="darlin. / EDIE / Feel Like Makin\' Loveへのアクセス情報。祐天寺エリアの3店舗、それぞれの住所・営業時間・地図はこちら。"
>
  <main class="pt-26 md:pt-28 pb-12 px-6 md:px-12 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-3xl font-medium tracking-wide text-stone-950 mb-12 text-center">Access</h1>

    <div class="flex flex-col gap-18">
      {stores.map((store) => <StoreSection store={store} />)}
    </div>
  </main>
</Layout>
