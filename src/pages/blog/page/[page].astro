---
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import BlogListing from '../../../components/blog/BlogListing.astro';
import { getSortedPosts, getArchiveGroups, PAGE_SIZE, type BlogPost } from '../../../lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  const pages = paginate(posts, { pageSize: PAGE_SIZE });
  // page 1 lives at /blog/ (see ../index.astro); only generate page 2+
  return pages.filter((p) => Number(p.params.page) !== 1);
}) satisfies GetStaticPaths;

interface Props {
  page: Page<BlogPost>;
}

const { page } = Astro.props;
const allPosts = await getSortedPosts();
const archiveGroups = getArchiveGroups(allPosts);
---

<Layout
  title={`Blog Page ${page.currentPage} | darlin. / EDIE / Feel Like Makin' Love`}
  description="darlin. / EDIE / Feel Like Makin\' Loveのブログ。ヘアスタイルの提案から、日々のスナップまで発信しています。"
>
  <BlogListing
    posts={page.data}
    archiveGroups={archiveGroups}
    pagination={{ currentPage: page.currentPage, lastPage: page.lastPage }}
  />
</Layout>
