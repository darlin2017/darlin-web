---
import Layout from '../layouts/Layout.astro';
import ScrollGallery from '../components/home/ScrollGallery.astro';
import { getHomeGalleries } from '../lib/home';
import { optimizeImageUrl } from '../lib/microcms';

const homeGalleries = await getHomeGalleries();
// Resize/re-encode via microCMS's image API instead of shipping full camera-resolution originals
// (displayed at max 460px wide, so 960px covers retina without sending multi-MB source files).
const galleryImages = (homeGalleries[0]?.galleryImages ?? []).map((image, index) => ({
  src: optimizeImageUrl(image.url, 960),
  alt: `darlin. gallery ${index + 1}`,
}));
---

<Layout
  title="darlin. / EDIE / Feel Like Makin' Love"
  description="目黒区・祐天寺の美容室 darlin. / EDIE / Feel Like Makin\' Loveの公式サイトです。ヘアスタイルを通して日本人の美しさ、強さを表現しながら、音楽、アートなど東京のカルチャーを発信しているサロンです。"
  showFooter={false}
>
  <main class="bg-white text-stone-950 font-base">
    <h1 class="sr-only">darlin. / EDIE / Feel Like Makin' Love</h1>
    {galleryImages.length > 0 ? (
      <ScrollGallery images={galleryImages}>
        <div slot="footer" class="pb-6 text-center px-4 flex flex-col items-center gap-1.5">
          <a href="/privacy-policy" class="text-[5px] md:text-[7px] tracking-[0.3em] text-stone-400 hover:text-stone-950 transition-colors uppercase">
            Privacy Policy
          </a>
          <p class="text-[5px] md:text-[7px] tracking-[0.4em] text-stone-400 uppercase leading-none">
            Copyrights © darlin. All Rights Reserved.
          </p>
        </div>
      </ScrollGallery>
    ) : (
      <div class="h-dvh flex flex-col items-center justify-center gap-6">
        <p class="text-sm text-stone-400">ギャラリー画像がありません。</p>
        <a href="/privacy-policy" class="text-[5px] md:text-[7px] tracking-[0.3em] text-stone-400 hover:text-stone-950 transition-colors uppercase">
          Privacy Policy
        </a>
        <p class="text-[5px] md:text-[7px] tracking-[0.4em] text-stone-400 uppercase leading-none">
          Copyrights © darlin. All Rights Reserved.
        </p>
      </div>
    )}
  </main>
</Layout>
