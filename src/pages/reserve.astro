---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logoDarlin from '../assets/logos/logo-darlin.png';
import logoEdie from '../assets/logos/logo-edie.png';
import logoFeelLikeMakinLove from '../assets/logos/logo-feellikemakinlove.png';

const stores = [
  {
    name: 'darlin.',
    logo: logoDarlin,
    reserveUrl: 'https://airrsv.net/darlinhair/calendar',
    heightClass: 'h-12 md:h-14',
  },
  {
    name: 'EDIE',
    logo: logoEdie,
    reserveUrl: 'https://airrsv.net/edietokyo/calendar',
    heightClass: 'h-14 md:h-18',
  },
  {
    name: "Feel Like Makin' Love",
    logo: logoFeelLikeMakinLove,
    reserveUrl: 'https://airrsv.net/feellikemakinlove/calendar',
    heightClass: 'h-16 md:h-20',
  },
];
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="darlin. / EDIE / Feel Like Makin' Love — Reserve" />
  <title>Reserve | darlin. / EDIE / Feel Like Makin' Love</title>

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v3.png" />
  <link rel="apple-touch-icon" sizes="167x167" href="/apple-touch-icon-167x167-v3.png" />
  <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152-v3.png" />
  <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120-v3.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preload" href="/fonts/switzer/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap"
  />
</head>

<body class="bg-white text-stone-950 font-base min-h-[100dvh]">
  <main class="min-h-[100dvh] flex flex-col items-center justify-center gap-18 md:gap-22 px-6">
    <h1 class="sr-only">Reserve | darlin. / EDIE / Feel Like Makin' Love</h1>
    {stores.map((store) => (
      <a href={store.reserveUrl} class="hover:opacity-60 transition-opacity">
        <Image
          src={store.logo}
          alt={store.name}
          loading="eager"
          class={`${store.heightClass} w-auto object-contain`}
        />
      </a>
    ))}
  </main>
</body>
</html>
