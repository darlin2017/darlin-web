---
import Layout from '../layouts/Layout.astro';
import EventItem from '../components/event/EventItem.astro';
import { getEvents } from '../lib/event';

const events = await getEvents();
const isEmpty = events.length === 0;
---

<Layout
  title="Event | darlin. / EDIE / Feel Like Makin' Love"
  description="darlin. / EDIE / Feel Like Makin\' Loveのイベント情報。周年パーティーや特別企画など、様々な催しをお知らせします。"
>
  <main
    class:list={[
      'pt-26 md:pt-28 pb-12 px-6 md:px-12 max-w-2xl mx-auto',
      isEmpty && 'max-md:min-h-[calc(100svh-104px)] md:h-[calc(100dvh-112px)] flex flex-col',
    ]}
  >
    <h1 class="text-2xl md:text-3xl font-medium tracking-wide text-stone-950 mb-12 text-center">Event</h1>

    {events.length > 0 ? (
      <div class="max-w-[500px] mx-auto flex flex-col">
        {events.map((event) => <EventItem event={event} />)}
      </div>
    ) : (
      <div class="flex-1 flex items-center justify-center">
        <p class="text-base md:text-lg text-stone-600 leading-relaxed tracking-wider text-center">
          New events coming soon.
        </p>
      </div>
    )}
  </main>
</Layout>
