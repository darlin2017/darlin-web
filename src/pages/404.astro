---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 | darlin. / EDIE / Feel Like Makin' Love"
  description="お探しのページは見つかりませんでした。darlin. / EDIE / Feel Like Makin' Loveの公式サイトです。"
  noindex={true}
>
  <main class="max-md:min-h-[calc(100svh-104px)] md:h-[calc(100dvh-112px)] max-w-2xl mx-auto px-6 md:px-12 flex flex-col">
    <div class="flex-1 flex items-end justify-center">
      <h1 class="text-base md:text-lg text-stone-600 leading-relaxed tracking-wider text-center">
        Page not found.
      </h1>
    </div>
    <div class="flex-1 flex items-center justify-center">
      <a
        href="/"
        class="text-xs tracking-[0.15em] text-stone-400 hover:text-stone-950 transition-colors uppercase"
      >
        ← Home
      </a>
    </div>
  </main>
</Layout>
