---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StaffMember from '../components/staff/StaffMember.astro';
import { getStaffList, memberBelongsToSalon } from '../lib/staff';

const stores = await getCollection('access');
const allStaff = await getStaffList();
---

<Layout
  title="Staff | darlin. / EDIE / Feel Like Makin' Love"
  description="darlin. / EDIE / Feel Like Makin\' Loveのスタイリスト紹介。Instagramで各スタッフの世界観もチェックできます。"
>
  <main class="pt-26 md:pt-28 pb-12 px-6 md:px-12 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-3xl font-medium tracking-wide text-stone-950 mb-12 text-center">Staff</h1>

    {allStaff.length > 0 ? (
      <div class="flex flex-col gap-18">
        {stores.map((store) => {
          const members = allStaff.filter((member) => memberBelongsToSalon(member, store.id));
          if (members.length === 0) return null;

          return (
            <section>
              <h2 class="text-xl md:text-2xl font-medium tracking-wide text-stone-950">
                {store.data.storeName}
              </h2>

              <div class="mt-8 flex flex-col gap-10">
                {members.map((member) => (
                  <StaffMember member={member} />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <p class="text-sm text-stone-400 text-center">スタッフ情報がありません。</p>
    )}
  </main>
</Layout>
