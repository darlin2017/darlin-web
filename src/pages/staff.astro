---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StaffMember from '../components/staff/StaffMember.astro';

const stores = await getCollection('access');
const allStaff = await getCollection('staff');
---

<Layout title="Staff | darlin. / FEEL LIKE MAKIN' LOVE / EDIE">
  <main class="pt-32 md:pt-28 pb-12 px-6 md:px-12 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-3xl font-medium tracking-wide text-stone-950 mb-12 text-center">Staff</h1>

    {allStaff.length > 0 ? (
      <div class="flex flex-col gap-24">
        {stores.map((store) => {
          const members = allStaff.filter((member) => member.data.salon === store.id);
          if (members.length === 0) return null;

          return (
            <section>
              <h2 class="text-xl md:text-2xl font-medium tracking-wide text-stone-950">
                {store.data.storeName}
              </h2>

              <div class="mt-10 flex flex-col gap-12">
                {members.map((member) => (
                  <StaffMember member={member} />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <p class="text-sm text-stone-400 text-center">スタッフ情報がありません。</p>
    )}
  </main>
</Layout>
