---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import StaffMember from '../components/staff/StaffMember.astro';
import { getStaffList, memberBelongsToSalon } from '../lib/staff';
import logoDarlin from '../assets/logos/logo-darlin.png';
import logoEdie from '../assets/logos/logo-edie.png';
import logoFeelLikeMakinLove from '../assets/logos/logo-feellikemakinlove.png';

const stores = await getCollection('access');
const allStaff = await getStaffList();

const STORE_LOGOS: Record<string, { src: ImageMetadata; heightClass: string }> = {
  darlin: { src: logoDarlin, heightClass: 'h-8 md:h-10' },
  edie: { src: logoEdie, heightClass: 'h-8 md:h-11' },
  'feel-like-makin-love': { src: logoFeelLikeMakinLove, heightClass: 'h-11 md:h-14' },
};
---

<Layout
  title="Staff | darlin. / EDIE / Feel Like Makin' Love"
  description="darlin. / EDIE / Feel Like Makin\' Loveのスタイリスト紹介。Instagramで各スタッフの世界観もチェックできます。"
>
  <main class="pt-26 md:pt-28 pb-12 px-6 md:px-12 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-3xl font-medium tracking-wide text-stone-950 mb-12 text-center">Staff</h1>

    {allStaff.length > 0 ? (
      <div class="flex flex-col gap-20">
        {stores
          .map((store) => ({
            store,
            members: allStaff.filter((member) => memberBelongsToSalon(member, store.id)),
          }))
          .filter(({ members }) => members.length > 0)
          .map(({ store, members }, index) => (
            <section>
              <h2>
                <Image
                  src={STORE_LOGOS[store.id].src}
                  alt={store.data.storeName}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  class={`${STORE_LOGOS[store.id].heightClass} w-auto object-contain`}
                />
              </h2>

              <div class="mt-9 flex flex-col gap-10">
                {members.map((member) => (
                  <StaffMember member={member} />
                ))}
              </div>
            </section>
          ))}
      </div>
    ) : (
      <p class="text-sm text-stone-400 text-center">スタッフ情報がありません。</p>
    )}
  </main>
</Layout>
