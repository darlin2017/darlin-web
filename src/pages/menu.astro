---
import Layout from '../layouts/Layout.astro';
import MenuRow from '../components/menu/MenuRow.astro';
import { getMenuItems, groupMenuByCategory } from '../lib/menu';

const menuItems = await getMenuItems();
const groups = groupMenuByCategory(menuItems);
---

<Layout title="Menu | darlin. / FEEL LIKE MAKIN' LOVE / EDIE">
  <main class="pt-32 md:pt-28 pb-12 px-6 md:px-12 max-w-2xl mx-auto">
    <h1 class="text-2xl md:text-3xl font-medium tracking-wide text-stone-950 mb-12 text-center">Menu</h1>

    <div class="flex flex-col gap-14">
      {groups.map((group) => (
        <section>
          <h2 class="text-xl md:text-2xl font-medium tracking-wider text-stone-950">
            {group.category}
          </h2>

          <div class="mt-5 flex flex-col gap-2 tracking-wide">
            {group.items.map((item) => <MenuRow item={item} />)}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center gap-1 text-xs text-stone-500 text-center">
      <p>* Credit Cards Accepted</p>
    </div>

  </main>
</Layout>
